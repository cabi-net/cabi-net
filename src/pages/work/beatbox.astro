---
import Base from '../../layouts/Base.astro';

const LIVE = 'https://beatbox-azure.vercel.app/';
---
<Base title="beatbox">
  <article class="project-page">

    <header class="project-header">
      <h1>beatbox</h1>
      <div class="project-meta mono muted">
        <span>2026</span>
        <span>web / collaboration / audio</span>
        <a href={LIVE} target="_blank" rel="noopener">live ↗</a>
      </div>
    </header>

    <section class="project-body">
      <p>
        A collaborative marketplace and trading platform for beats. Producers
        list instrumentals with their metadata (BPM, key, tags) and users
        browse, preview, filter by tag, and switch between a list and a
        carousel view of the catalogue.
      </p>

      <div class="embed">
        <iframe
          src={LIVE}
          title="beatbox — live demo"
          loading="lazy"
          allow="autoplay; clipboard-write"
        ></iframe>
      </div>
      <p class="embed-note mono muted">
        Live embed. <a href={LIVE} target="_blank" rel="noopener">open in a new tab ↗</a>
      </p>

      <p class="wip mono">under construction</p>
    </section>

  </article>
</Base>

<style>
.project-page { max-width: 720px; }

.project-header { margin-bottom: var(--space-xl); }

h1 {
  font-family: var(--font-display);
  font-variation-settings: var(--peix-display);
  font-size: var(--size-3xl);
  font-weight: normal;
  margin-bottom: var(--space-md);
}

.project-meta {
  display: flex;
  gap: var(--space-lg);
  font-size: var(--size-xs);
}

.project-body p {
  max-width: 55ch;
  line-height: 1.8;
}

.project-body p + p { margin-top: var(--space-lg); }

.embed {
  margin: var(--space-xl) 0 var(--space-sm);
  aspect-ratio: 4 / 3;
  border: 1px solid var(--border);
}

.embed iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: none;
}

.embed-note { font-size: var(--size-xs); }

.embed-note a { border-bottom: 1px solid var(--border); }

.wip {
  margin-top: var(--space-2xl);
  font-size: var(--size-3xl);
  color: var(--fg-muted);
  opacity: 0.4;
}

@media (max-width: 600px) {
  .embed { aspect-ratio: 3 / 4; }
}
</style>
