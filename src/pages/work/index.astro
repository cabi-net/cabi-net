---
import Base from '../../layouts/Base.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

// external-only pieces link straight out; everything else goes to /work/<slug>
const projects = entries.map((e) => ({
  ...e.data,
  slug: e.slug,
  href: e.data.external ? e.data.links.live! : `/work/${e.slug}`,
}));
---
<Base title="work">
  <div class="work-index">
    <img src="/girl-blu.png" alt="" aria-hidden="true" class="girl-blu" />

    <div class="grid">
      {projects.map((p) => (
        <ProjectTile
          href={p.href}
          title={p.title}
          blurb={p.blurb}
          year={p.year}
          emphasis={p.emphasis}
          thumb={p.thumb}
          thumbPair={p.thumbPair}
          external={p.external}
        />
      ))}
    </div>
  </div>
</Base>

<style>
.work-index {
  max-width: 900px;
  margin-inline: auto;
  position: relative;
}

.girl-blu {
  position: fixed;
  bottom: -40px;
  right: -30px;
  height: 420px;
  width: auto;
  filter: invert(1) sepia(1) saturate(6) hue-rotate(280deg) brightness(1.1);
  opacity: 0.28;
  pointer-events: none;
  z-index: 0;
  mix-blend-mode: screen;
}

/* bento: 6 columns, tiles claim 4/3/2 of them by emphasis. `dense` lets a
   later small tile backfill a gap rather than leaving a hole in the grid. */
.grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-auto-flow: dense;
  gap: 1rem;
  position: relative;
  z-index: 1;
}

@media (max-width: 720px) {
  .grid { grid-template-columns: 1fr; }
}
</style>
