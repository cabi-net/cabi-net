---
import Base from '../../layouts/Base.astro';

const aboutImages = Object.keys(
  import.meta.glob('/public/assets/about/*.{png,gif,jpg,jpeg,webp,svg}')
)
  .map((path) => path.replace('/public', ''))
  .sort();
---
<Base title="about">
  <div class="about-page">

    <section class="bio">
      <p class="bio-text">
        <span class="lead">cabi-net is a&nbsp;</span>{aboutImages.map((src) => (
          <img class="about-img" src={src} alt="" aria-hidden="true" />
        ))}
      </p>
    </section>

    <section class="links mono">
      <a href="https://cabi-net.github.io/cv-website" target="_blank" rel="noopener">cv ↗</a>
      <a href="https://github.com/cabi-net" target="_blank" rel="noopener">github ↗</a>
    </section>

    <section class="colophon mono muted">
      <p class="colophon-label">colophon</p>
      <ul>
        <li>typeset in <a href="https://www.entravaux.fr" target="_blank" rel="noopener">Peix Variable</a> by En Travaux</li>
        <li>classical engravings — public domain</li>
        <li>Rider-Waite Tarot — Pamela Colman Smith, 1909, public domain</li>
        <li>built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></li>
      </ul>
    </section>

  </div>
</Base>

<style>
.about-page {
  max-width: 900px;
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.bio-text {
  font-size: var(--size-3xl);
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}

.lead {
  white-space: nowrap;
}

.about-img {
  height: 1em;
  width: auto;
  vertical-align: baseline;
  margin: 0 0.05em;
  display: inline;
}

.links {
  display: flex;
  gap: var(--space-lg);
  font-size: var(--size-sm);
}

.colophon {
  font-size: var(--size-xs);
  border-top: 1px solid var(--border);
  padding-top: var(--space-lg);
}

.colophon-label {
  margin-bottom: var(--space-sm);
  color: var(--fg-muted);
}

.colophon ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.colophon a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}
</style>
