---
import Base from '../../layouts/Base.astro';

const aboutImages = Object.keys(
  import.meta.glob('/public/assets/about/*.{png,gif,jpg,jpeg,webp,svg}')
)
  .map((path) => path.replace('/public', ''))
  .sort();
---
<Base title="about">
  <div class="about-page">

    <section class="bio">
      <p class="bio-text">
        <span class="lead">cabi-net is &nbsp;</span><span class="about-imgs">{aboutImages.map((src) => (
          <img class="about-img" src={src} alt="" aria-hidden="true" />
        ))}</span>
      </p>
    </section>

    <section class="links mono">
      <a href="https://cabi-net.github.io/cv" target="_blank" rel="noopener">cv ↗</a>
      <a href="https://github.com/cabi-net" target="_blank" rel="noopener">github ↗</a>
    </section>

    <section class="colophon mono muted">
      <p class="colophon-label">colophon</p>
      <ul>
        <li>typeset in <a href="https://www.entravaux.fr" target="_blank" rel="noopener">Peix Variable</a> by En Travaux</li>
        <li>classical engravings — public domain</li>
        <li>Rider-Waite Tarot — Pamela Colman Smith, 1909, public domain</li>
        <li>built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></li>
      </ul>
    </section>

  </div>

  <script>
    const wrap = document.querySelector('.about-imgs');
    if (wrap) {
      const imgs = Array.from(wrap.querySelectorAll('img'));
      const srcs = imgs.map((img) => img.getAttribute('src'));
      for (let i = srcs.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [srcs[i], srcs[j]] = [srcs[j], srcs[i]];
      }
      // Reassign sources onto the fixed nodes; nodes are never re-parented,
      // so animated GIFs can't be dropped mid-decode the way appendChild caused.
      imgs.forEach((img, i) => img.setAttribute('src', srcs[i]));
    }
  </script>
</Base>

<style>
.about-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.bio-text {
  font-size: var(--size-3xl);
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}

.lead {
  white-space: nowrap;
}

.about-img {
  height: 1em;
  width: auto;
  vertical-align: middle;
  margin: 0 0.05em;
  display: inline-block;
}

.links {
  display: flex;
  gap: var(--space-lg);
  font-size: var(--size-3xl);
  font-weight: 600;
}

.colophon {
  position: relative;
  font-size: var(--size-xs);
  padding-top: var(--space-lg);
  max-width: 600px;
  margin-inline: auto;
}

.colophon::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 10px;
  background-image: var(--spiral-coil);
  background-repeat: repeat-x;
  background-size: auto 10px;
  opacity: 0.3;
  pointer-events: none;
}

.colophon-label {
  margin-bottom: var(--space-sm);
  color: var(--fg-muted);
}

.colophon ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.colophon a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}
</style>
